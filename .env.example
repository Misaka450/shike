# ==================== 后端配置（backend） ====================

# 服务监听端口（Docker Compose 中由 docker-compose.yml 覆盖为 8081）
PORT=8081

# SQLite 数据库文件路径
# Linux / 容器内推荐：/opt/shike-ai/data/db/shike.db
# Windows 本地开发建议改为相对路径，例如：./data/db/shike.db（否则会尝试往当前盘符根目录写文件）
DB_PATH=/opt/shike-ai/data/db/shike.db

# CLIProxyAPI（CPA）多模态模型反向代理地址
CPA_URL=http://127.0.0.1:5201/v1

# CPA 访问凭据（必填，不填则识图与 AI 生成菜谱功能不可用）
CPA_API_KEY=your_cpa_api_key_here

# 允许跨域访问后端的来源白名单，多个用英文逗号分隔
CORS_ORIGINS=http://127.0.0.1:3002,http://localhost:3002

# 是否信任反向代理传来的 X-Forwarded-For 请求头
# 【重要】只有在前置了 Nginx / Cloudflare 等可信代理时才设为 true；
# 直接暴露端口时保持 false，否则客户端可以伪造该头绕过登录失败锁定
TRUST_PROXY=false

# 登录会话有效期（单位：天）
SESSION_TTL_DAYS=30

# ==================== 前端配置（frontend） ====================

# Next 服务端转发 /api 请求的目标地址（rewrites 在容器内执行）
# 本地开发：http://127.0.0.1:8081
# Docker Compose：http://shike-api:8081（必须用服务名，用 127.0.0.1 会指向容器自身）
API_INTERNAL_URL=http://127.0.0.1:8081